// A launch configuration that compiles the extension and then opens it inside a new window
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Client",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--profile-temp",
        "--extensionDevelopmentPath=${workspaceRoot}/packages/editors/vscode"
      ],
      "outFiles": ["${workspaceRoot}/packages/editors/vscode"],
      "preLaunchTask": "npm: watch"
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to Server",
      "port": 6009,
      "restart": true,
      "outFiles": ["${workspaceRoot}/packages/server/dist/**/*.js"]
    },
    {
      "name": "Debug Current TS File",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["-r", "ts-node/register"],
      "args": ["${file}"],
      "env": {
        "TS_NODE_PROJECT": "${workspaceFolder}/packages/server/tsconfig.json"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Client + Server",
      "configurations": ["Launch Client", "Attach to Server"]
    }
  ]
}
